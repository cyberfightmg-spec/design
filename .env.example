# ============================
# INTERIOR STYLE BOT — ENV
# ============================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Image Provider ---
# Options: chatgpt-browser | openai-api
IMAGE_PROVIDER=chatgpt-browser

# ChatGPT browser persistent profile path
CHATGPT_BROWSER_PROFILE=./data/chatgpt-profile

# Headless mode (set false to debug browser automation)
BROWSER_HEADLESS=true

# --- Fish Audio TTS ---
# Options: api | browser
FISH_MODE=api
FISH_API_KEY=
FISH_VOICE_ID=
FISH_API_BASE_URL=https://api.fish.audio/v1

# --- Geometry Guardian ---
# Options: basic | advanced
GEOMETRY_GUARDIAN_MODE=basic
GEOMETRY_GUARDIAN_URL=http://localhost:8001

# Retries on geometry fail
MAX_GEOMETRY_RETRIES=3

# --- Video ---
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# --- Background Music ---
BGM_ENABLED=false
# BGM_FILE=./assets/audio/background.mp3
# BGM_VOLUME=0.15

# --- Debug ---
# Show visual overlay (original vs generated 50%)
COMPARE_MODE=false

# Log level: debug | info | warn | error
LOG_LEVEL=info

# --- Storage ---
STORAGE_PATH=./storage
